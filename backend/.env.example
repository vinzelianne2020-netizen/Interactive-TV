APP_NAME="Knowles Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db.tugkybqqqembvqingyzr.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SUPABASE_URL=https://tugkybqqqembvqingyzr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_olwJdELypgad5X6AbdAKpw_pJc7vTkQ
# Server-only key for Supabase Storage uploads/deletes. Never expose this to Vite.
SUPABASE_SERVICE_ROLE_KEY=

WEATHER_API_KEY=
WEATHER_LAT=10.3103
WEATHER_LON=123.8854
WEATHER_CITY="Cebu City, Philippines"

FRONTEND_URL=http://localhost:5173
# For multiple frontends (comma-separated), use FRONTEND_URLS instead:
# FRONTEND_URLS=http://localhost:5173,https://interactive-tv.onrender.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Leave empty for separate Render frontend/backend services so cookies use the backend host.
SESSION_DOMAIN=

# --- Cookie security (CRITICAL for cross-host Render deployments) ---
# On localhost: use lax + no secure (HTTP works)
# On Render/HTTPS with different frontend/backend hostnames: set same_site=none AND secure=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
# Production/Render example:
# SESSION_SAME_SITE=none
# SESSION_SECURE_COOKIE=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TrustProxies - set to * for Render/Fly.io/Heroku and other reverse proxies:
# TRUSTED_PROXIES=*
